{
  "name": "talon-replay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D flight replay of Talon UAV autopilot simulations (EKF, state machine, NLGL guidance)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.2.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.170.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
